  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Local-first macOS multi-agent coding workspace powered by Grok Build",
  "homepage": "https://github.com/liarzpl/grokspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liarzpl/grokspace.git"
  },
