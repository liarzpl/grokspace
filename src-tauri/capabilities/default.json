{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main GrokSpace window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:window:allow-request-user-attention",
    "allow-log-client-error",
    "allow-list-projects",
    "allow-open-project",
    "allow-update-project",
    "allow-touch-project",
    "allow-remove-project",
    "allow-list-sessions",
    "allow-create-session",
    "allow-attach-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-stop-session",
    "allow-restart-session",
    "allow-rename-session",
    "allow-close-session",
    "allow-discard-session-worktree",
    "allow-merge-session-worktree",
    "allow-session-merge-readiness",
    "allow-prompt-session",
    "allow-cancel-session",
    "allow-answer-session-permission",
    "allow-list-memory",
    "allow-put-memory",
    "allow-remove-memory",
    "allow-memory-file-path",
    "allow-skill-status",
    "allow-install-skill",
    "allow-list-tasks",
    "allow-create-task",
    "allow-update-task",
    "allow-dispatch-task",
    "allow-undispatch-task",
    "allow-remove-task",
    "allow-project-diff",
    "allow-file-diff",
    "allow-reveal-artifact",
    "allow-read-settings",
    "allow-write-setting",
    "allow-read-permission-policy",
    "allow-write-permission-policy",
    "allow-read-session-graph",
    "allow-list-session-graphs",
    "allow-watch-project-graphs",
    "allow-list-session-steps",
    "allow-list-project-steps",
    "allow-add-session-step",
    "allow-update-session-step",
    "allow-remove-session-step",
    "allow-reorder-session-steps",
    "allow-approve-session-steps",
    "allow-reopen-session-steps",
    "allow-watch-project-steps"
  ]
}
